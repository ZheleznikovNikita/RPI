<div class="volume-control">
  <div class="volume-heading">
    <label for="<%= control_id %>">Громкость музыки</label>
    <output for="<%= control_id %>" data-volume-output>35%</output>
  </div>
  <input id="<%= control_id %>" class="range-input" type="range" min="0" max="100" step="1" value="35" data-setting="volume">
</div>
