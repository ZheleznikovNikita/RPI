<% content_for :title, "Авторизация - RPI" %>
<% content_for :body_class, "page-shell auth-page" %>

<main class="auth-screen">
  <section class="auth-card" aria-labelledby="auth-title">
    <%= link_to "Назад в меню", root_path, class: "back-link" %>
    <h1 id="auth-title">Авторизация</h1>
    <p class="auth-copy">
      Войдите в профиль игрока, чтобы продолжить будущие сохранения и историю персонажа.
    </p>

    <%= form_with url: login_path, class: "auth-form" do |form| %>
      <div class="field">
        <%= form.label :email, "Email" %>
        <%= form.email_field :email, value: @email, placeholder: "player@example.com", autocomplete: "email" %>
      </div>

      <div class="field">
        <%= form.label :password, "Пароль" %>
        <%= form.password_field :password, placeholder: "Пароль", autocomplete: "current-password" %>
      </div>

      <%= form.submit "Войти", class: "btn btn-primary" %>
    <% end %>

    <p class="auth-switch">
      Профиля ещё нет? <%= link_to "Создать", register_path %>
    </p>
  </section>
</main>