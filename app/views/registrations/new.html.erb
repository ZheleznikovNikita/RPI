<% content_for :title, "Регистрация - RPI" %>
<% content_for :body_class, "page-shell auth-page" %>

<main class="auth-screen">
  <section class="auth-card" aria-labelledby="registration-title">
    <%= back_arrow_to root_path, label: "В главное меню" %>
    <h1 id="registration-title">Регистрация</h1>
    <p class="auth-copy">
      Создайте профиль игрока и начните свою историю.
    </p>

    <% if @user.errors.any? %>
      <div class="form-errors" role="alert">
        <strong>Не удалось создать профиль</strong>
        <ul>
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @user, url: register_path(profile_navigation_options), class: "auth-form" do |form| %>
      <div class="field">
        <%= form.label :name, "Имя игрока" %>
        <%= form.text_field :name, placeholder: "Странник", autocomplete: "name", required: true, maxlength: 40 %>
      </div>

      <div class="field">
        <%= form.label :email, "Email" %>
        <%= form.email_field :email, placeholder: "player@example.com", autocomplete: "email", required: true %>
      </div>

      <div class="field">
        <%= form.label :password, "Пароль" %>
        <%= form.password_field :password, autocomplete: "new-password", required: true, minlength: 12, aria: { describedby: "password-help" } %>
        <small id="password-help">От 12 символов, не более 72 байт. Используйте длинную фразу из несвязанных слов. Избегайте имени, email и предсказуемых сочетаний.</small>
      </div>

      <div class="field">
        <%= form.label :password_confirmation, "Повторите пароль" %>
        <%= form.password_field :password_confirmation, placeholder: "Повторите пароль", autocomplete: "new-password", required: true %>
      </div>

      <%= form.submit "Создать профиль", class: "btn btn-primary" %>
    <% end %>
  </section>
</main>
